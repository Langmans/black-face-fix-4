# Settings.psd1 - everything that is not a resolution profile.
#
# Profiles live in ..\Profiles\*.psd1 and only decide sizes.
# Slot format rules live in ..\Rules\SlotRules.psd1.

@{
    # 'Auto' detects the profile from the HD DLC archive and the LooksMenu
    # uTintWidth setting. Otherwise use the exact Name from a Profiles\*.psd1 file:
    # 'Vanilla', 'HD DLC', '2K' or '4K'.
    Profile = 'Auto'

    Paths = @{
        # Leave empty to read from the registry / auto-detect.
        Fallout4   = ''
        MO2        = ''   # the MO2 install folder, not the mods folder
        MO2Profile = ''   # empty = whatever profile MO2 has selected

        # Folder holding texconv.exe and texdiag.exe. Empty means: use the bundled
        # MSFT folder, then PATH, then winget's package folder.
        TexTools   = ''
    }

    Scope = @{
        # Only scan mods enabled with '+' in the active MO2 profile's modlist.txt.
        OnlyEnabledMods          = $true
        IncludeGameData          = $true
        IncludeOverwrite         = $true

        # Baked NPC facegen under textures\actors\character\facecustomization.
        # Off by default: these are generated per plugin and are usually better
        # regenerated by the mod author than rescaled here.
        IncludeFaceCustomization = $false

        # Read BA2 archives and report face textures that mismatch the profile.
        # Reporting never modifies anything.
        IncludeArchives          = $true

        # Extract mismatching textures out of BA2s, fix them, and drop them in the
        # output mod as loose files. Loose files win over archives in Fallout 4, so
        # the original mod is never touched. Archives are never repacked.
        FixArchives              = $false

        # Whether FixArchives may also touch the GAME's own archives
        # (Fallout4 - Textures*.ba2 and the DLC ones). Off on purpose: writing a
        # loose override of base game content is a far bigger step than fixing a
        # mod, and the engine already downsamples anything above 1K for the head.
        # Bethesda ships CryoHumanMale\HeadMale_d.DDS at 2048, for example.
        # Game archives are still inspected and reported either way.
        FixGameArchives          = $false

        # Applied to the path relative to textures\, case-insensitive, as regex.
        #   Hair  - 'Headgear01_d.dds' matches the head name pattern, and hair colour
        #           LUTs (lmcc1.dds, 64x128) live there too.
        #   Eyes  - eye textures are a separate texture set in the game's own records
        #           and take no part in the head/tint matching. Excluding the folder
        #           also kills the 'HumanEyesRedHead.dds' substring trap, where the
        #           head pattern matches the 'head' in 'RedHead'.
        ExcludePathPatterns      = @('\\hair\\', '\\eyes\\', '\\facegendata\\')

        # MO2 mod folder names to skip entirely.
        ExcludeMods              = @()
    }

    # How a .dds under textures\actors\character is recognised as a face texture.
    # Three layers, checked in this order:
    #   1. Rules\VanillaFaceTextures.psd1 - the exact paths the game's own TXST
    #      records declare as face textures. This is what catches Preston_d.dds,
    #      Mayor_s.dds and Piper's set, none of which have "head" in the name.
    #   2. FullScanFolders - every .dds underneath counts, whatever it is called.
    #   3. HeadNamePattern - anywhere else, only files whose name matches.
    # Anything that matches none of the three is left alone.
    FaceRules = @{
        FullScanFolders = @(
            'Character Assets\FaceDetails',
            'Character Assets\TintMasks'
        )

        # Deliberately a loose substring and not 'head_'. Surveying every texture
        # path the official plugins declare under actors\character gives four
        # naming shapes:
        #
        #   A  21  basemalehead_d.dds            ...head_<slot>        clean
        #   B   2  headwrinkles_n.dds            ...head<word>_<slot>  face texture
        #   C   3  femaleheadweathered1_d.dds    ...head<word><digit>_ face texture
        #   D  50  preston_d.dds, basemalebody_d.dds, basemalehands_n.dds,
        #          femalebrows_d.dds, mouthhuman_n.dds                 no 'head'
        #
        # 'head_' would miss B and C - five real vanilla face textures - so a mod
        # shipping its own wrinkle or weathered maps would be silently skipped.
        # Of bucket D only Preston, Mayor and Piper are face textures, and those
        # come from Rules\VanillaFaceTextures.psd1 instead. The other 43 are body,
        # hands, brows and mouth maps, which have no 'head' in the name and so are
        # never matched by this pattern - which is exactly what we want, because
        # body textures sit in the same folders and run up to 8192px.
        HeadNamePattern = 'head'
    }

    Output = @{
        # 'OutputMod' writes fixed textures into MO2 mods of their own, leaving
        # every source mod untouched. 'InPlace' overwrites the original and leaves
        # a <name.ext>.backup next to it.
        Mode = 'OutputMod'

        # One output mod PER SOURCE MOD, not one shared folder.
        # {0} is the source mod's folder name, {1} is the profile.
        #
        #   Extra Textures for V3 Alpha 1
        #   Extra Textures for V3 Alpha 1 [face-Vanilla]
        #
        # Put each output directly below its source in the mod list and the load
        # order you already have keeps working. A single shared output mod cannot
        # do that: when two mods ship the same face texture, whichever the scan
        # happened to reach last would win, regardless of MO2 priority - and the
        # shared mod sits at the bottom, so it also overrides mods it has nothing
        # to do with.
        OutputModNameFormat = '{0} [face-{1}]'

        # Used in place of {0} for textures that do not come from a mod.
        GameDataModName  = 'Fallout 4 Data'
        OverwriteModName = 'MO2 Overwrite'

        BackupSuffix = '.backup'
    }

    Conversion = @{
        # texconv -if value. FANT is DirectXTex's default and is the better choice
        # for downscaling; CUBIC looks slightly better when upscaling.
        Filter        = 'FANT'

        # Adds -bcmax -sepalpha on BC7 targets. Slower, noticeably better quality.
        UseBcMax      = $true

        # Safety rails. Anything that trips these is reported as 'Review' and is
        # never converted, because it is almost certainly not a face texture:
        # LUTs, palettes and lookup strips are small and non-square.
        MinSize       = 256
        RequireSquare = $true

        # $true looks on PATH and in winget's package folder before the bundled
        # MSFT copy, so 'winget install Microsoft.DirectXTex.Texconv' wins and stays
        # current. $false (default) keeps the bundled copy authoritative, which is
        # what you want when handing the tool to someone else.
        PreferSystemTools = $false
    }

    Logging = @{
        # Writes every texdiag/texconv command line to the log.
        Debug = $false
    }
}
